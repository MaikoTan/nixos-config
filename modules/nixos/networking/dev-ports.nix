{ config, lib, ... }:let  cfg = config.maiko.dev-ports;in{  options.maiko.dev-ports.enable = lib.mkOption {    type = lib.types.bool;    default = false;    description = "Open common development server TCP ports in the firewall (desktop machines).";  };  config = lib.mkIf cfg.enable {    # 常用开发服务器端口（Vite / Next.js / 通用 dev server），对所有桌面机器开放    networking.firewall.allowedTCPPortRanges = [      {        from = 5173;        to = 5183;      } # Vite dev server      {        from = 4000;        to = 4010;      } # Other common dev server ports      {        from = 3000;        to = 3010;      } # Next.js dev server      {        from = 8080;        to = 8090;      } # Common dev server port    ];  };}
