# Machine-specific toggles for home-manager.
# Set these in per-machine home configurations (e.g. machines/<host>/home.nix).
{
  lib,
  ...
}:

{
  options.maiko.hm = {
    desktop = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Enable desktop (GUI) configuration: Plasma, GNOME dconf, IME, GUI packages.
        Used on full desktop machines (e.g. company). Disabled on WSL.
      '';
    };

    android = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Enable the Android toolchain: the official `android` CLI and the
        user-managed SDK under ~/Android/Sdk (desktop only).
      '';
    };

    # Toggle groups that were previously always-on. Defaults preserve current
    # behavior (everything enabled); they exist so per-machine configs can opt
    # out of whole feature sets without editing the shared modules.
    git = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable git, gh, and gh-dash configuration.";
    };

    extras = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable direnv, zoxide, jq, and fastfetch programs.";
    };

    services = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable background services (gpg-agent, remmina).";
    };

    magpie = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Enable the Magpie AI gateway: the CLI, the user service running
        `magpie serve`, and the SOPS backup helper for its provider
        configuration (which Magpie itself maintains at runtime).
      '';
    };

    # `magpie daemon web on` cannot be used here: it rewrites the systemd unit
    # that Magpie installed, while this unit is generated by home-manager.
    # The equivalent is the `--web` argument to `magpie serve`, set below.
    magpieWeb = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = "";
      example = "0.0.0.0:3430";
      description = ''
        Serve Magpie's web page from the gateway service (`magpie serve --web`).
        An empty string uses Magpie's default address (127.0.0.1:3430);
        "host:port" binds the page elsewhere; null keeps the page off.
      '';
    };

    magpieWebKeyFile = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "/run/secrets/magpie-web-key";
      description = ''
        Optional systemd EnvironmentFile holding a `MAGPIE_WEB_KEY=...` line,
        read by the Magpie service to keep the web page's sign-in key stable
        across restarts. Without it Magpie makes a new key on every start, so
        both the link (logged to the journal) and the browser's sign-in change.
        The key needs at least 16 letters, digits, or `- . _ ~`.
      '';
    };
  };
}
